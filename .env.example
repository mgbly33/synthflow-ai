# Database URL
# Default local zero-config SQLite:
DATABASE_URL=sqlite+aiosqlite:///./synthflow.db
# For PostgreSQL (e.g. Docker Compose):
# DATABASE_URL=postgresql+asyncpg://synthflow:synthflow@postgres:5432/synthflow

# Optional Fernet encryption key (base64 32-byte key). If omitted, auto-generated and stored locally in apps/api/.secret.key
FERNET_SECRET_KEY=

# Optional default OpenAI-compatible provider (can also be configured in UI)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Demo streaming token delay in milliseconds (0 for instant tests)
DEMO_STREAM_DELAY_MS=28
